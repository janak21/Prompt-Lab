# Copy to .env (or rely on a .env in this directory or any parent directory --
# backend/app/config.py walks up looking for one) and fill in.

# Required for any run/generation that calls the model. Never stored in the DB,
# never returned by the API, never logged.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides -- uncomment to change the default.

# Path to the SQLite database file. Relative paths resolve against the
# promptlab/ project root.
# PROMPTLAB_DB=promptlab/promptlab.db

# Port uvicorn listens on (also read by run.sh).
# PORT=8000

# Set to 1 to opt into the live-API test tier (backend/tests/test_live_api.py),
# which makes real, billed Anthropic API calls. Never set in CI.
# PROMPTLAB_LIVE_TESTS=1

# Model used to generate output when a run or dataset-generation request doesn't
# specify one.
# DEFAULT_MODEL=claude-haiku-4-5

# Model used by llm_judge graders when a run doesn't specify a judge model.
# DEFAULT_JUDGE_MODEL=claude-sonnet-5

# How many test cases a run evaluates in parallel when the request doesn't set
# concurrency explicitly.
# DEFAULT_CONCURRENCY=5

# Upper bound the concurrency a run can request, regardless of what's asked for.
# MAX_CONCURRENCY=20

# Origin allowed by CORS. Only matters when running the frontend dev server
# separately from the backend (see --dev in run.sh); the built frontend is
# served same-origin and ignores this.
# CORS_ORIGIN=http://localhost:5173
